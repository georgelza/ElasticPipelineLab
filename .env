# S3 Configuration
# The S3 bucket name maps 1:1 to the source AWS account name (a set of
# information/systems aligned and managed together financially/governance
# wise). Elasticsearch snapshot repositories are registered per account with
# the SAME name as the bucket — see scripts/configure_s3_snapshots.sh for the
# eight security-classification accounts (prod-pci, prod-nonpci, prod-ife, ...).
# S3_PROJECT_NAME is the FIRST element of the object path inside each bucket
# (e.g. log_analytics/year=yyyy/month=mm/day=dd/<instance>).
S3_PROJECT_NAME=log_analytics
S3_AWS_ACCOUNT_NAME=sec-proxy
S3_ENDPOINT=http://s3.amazonaws.com
S3_BUCKET_NAME=payinc
S3_ACCESS_KEY_ID=minio-access-key
S3_SECRET_ACCESS_KEY=minio-secret-key
S3_REGION=af-south-1
 